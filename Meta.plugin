#!name = Meta 分流
#!desc = Meta 全家桶统一走代理：Facebook / Instagram / Threads / WhatsApp / Messenger / Oculus / Meta AI。安装时在插件里自选策略（PROXY 指向你自己的策略组），不含任何节点与订阅信息。
#!author = Tanin4527
#!homepage = https://github.com/Tanin4527/Loon
#!date = 2026-11-24
#!tag = 分流,Meta
#!type = normal

[Rule]
# === Meta / 公司主域 ===
DOMAIN-SUFFIX,meta.com,PROXY
DOMAIN-SUFFIX,meta.ai,PROXY
DOMAIN-SUFFIX,metaquest.com,PROXY
DOMAIN-SUFFIX,accountkit.com,PROXY
DOMAIN-SUFFIX,crowdtangle.com,PROXY
DOMAIN-SUFFIX,workplace.com,PROXY
DOMAIN-SUFFIX,expresswifi.com,PROXY
DOMAIN-SUFFIX,freebasics.com,PROXY
DOMAIN-SUFFIX,internet.org,PROXY

# === Facebook ===
DOMAIN-SUFFIX,facebook.com,PROXY
DOMAIN-SUFFIX,facebook.net,PROXY
DOMAIN-SUFFIX,facebook.org,PROXY
DOMAIN-SUFFIX,facebookmail.com,PROXY
DOMAIN-SUFFIX,facebookbrand.com,PROXY
DOMAIN-SUFFIX,fb.com,PROXY
DOMAIN-SUFFIX,fb.me,PROXY
DOMAIN-SUFFIX,fb.watch,PROXY
DOMAIN-SUFFIX,fb.gg,PROXY
DOMAIN-SUFFIX,fbcdn.net,PROXY
DOMAIN-SUFFIX,fbcdn.com,PROXY
DOMAIN-SUFFIX,fbsbx.com,PROXY
DOMAIN-SUFFIX,fbaddins.com,PROXY
DOMAIN-SUFFIX,fbworkmail.com,PROXY
DOMAIN-KEYWORD,facebook,PROXY

# === Instagram ===
DOMAIN-SUFFIX,instagram.com,PROXY
DOMAIN-SUFFIX,cdninstagram.com,PROXY
DOMAIN-SUFFIX,ig.me,PROXY
DOMAIN-SUFFIX,instagram.net,PROXY

# === Threads ===
DOMAIN-SUFFIX,threads.net,PROXY
DOMAIN-SUFFIX,threads.com,PROXY

# === Messenger ===
DOMAIN-SUFFIX,messenger.com,PROXY
DOMAIN-SUFFIX,m.me,PROXY

# === WhatsApp ===
DOMAIN-SUFFIX,whatsapp.com,PROXY
DOMAIN-SUFFIX,whatsapp.net,PROXY
DOMAIN-SUFFIX,whatsapp.biz,PROXY
DOMAIN-SUFFIX,whatsappbrand.com,PROXY
DOMAIN-SUFFIX,wa.me,PROXY

# === Oculus / VR ===
DOMAIN-SUFFIX,oculus.com,PROXY
DOMAIN-SUFFIX,oculuscdn.com,PROXY

# === Meta IP 段 (AS32934, RIPEstat 每周自动抓取) ===
