# === LINUX DO 备用域名及全部子站 ===
DOMAIN-SUFFIX,linuxdo.org,DIRECT
DOMAIN,linuxdo.org,DIRECT

# === crt.sh 本周发现的 linuxdo.org 子站 ===
DOMAIN,mail.linuxdo.org,DIRECT
DOMAIN,meet.linuxdo.org,DIRECT
